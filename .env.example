# ============================================================
# Konfigurasi Environment - Aplikasi Panen Bawang Merah
# ============================================================

# Salin file ini menjadi .env dan isi sesuai kebutuhan

# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database Configuration
DATABASE_URL=sqlite:///panen_bawang.db
# Untuk PostgreSQL: postgresql://user:password@localhost/dbname
# Untuk MySQL: mysql+pymysql://user:password@localhost/dbname

# Debug Mode
DEBUG=True

# Server Configuration
HOST=127.0.0.1
PORT=5000

# Aplikasi Info
APP_NAME=Sistem Pencatatan Panen Bawang Merah
APP_VERSION=1.0.0

# Pagination
ITEMS_PER_PAGE=10

# Session Configuration
SESSION_COOKIE_SECURE=False  # Set True jika menggunakan HTTPS
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME=604800  # 7 hari dalam detik

# Email Configuration (opsional, jika ada fitur email)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16 MB
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif
